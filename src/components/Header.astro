---
/**
 * Header.astro — single-row header modeled on the competitor:
 *   brand text (left, last word accented) · flat inline nav links · prominent phone (right).
 * No dropdowns, no separate navy band. Every service and city is still linked from the
 * homepage sections and the Footer, so internal linking is unchanged. The nav wraps to a
 * second row on mobile; the sticky mobile call bar (see index) backs up the phone CTA.
 */
import { SITE, tel } from '@config/site';
import { serviceUrl } from '../lib/urls';

// Brand: accent the last word (e.g. "Olympic Peninsula" + "Septic").
const brandWords = SITE.company.split(' ');
const brandAccent = brandWords[brandWords.length - 1];
const brandLead = brandWords.slice(0, -1).join(' ');

// Lean nav, like the competitor: a few key services + Service Areas.
const NAV = [
  { label: 'Septic Pumping', href: serviceUrl('septic-tank-pumping') },
  { label: 'Inspections', href: serviceUrl('septic-inspections') },
  { label: 'Drain Field', href: serviceUrl('drain-field-repair') },
  { label: 'Emergency', href: serviceUrl('emergency-septic-service') },
  { label: 'Service Areas', href: '/#areas' },
];
---

<header class="site-header">
  <div class="bar">
    <a class="brand" href="/" aria-label={`${SITE.company} home`}>
      {brandLead} <span>{brandAccent}</span>
    </a>

    <nav class="nav" aria-label="Primary">
      {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <a class="header-phone" href={tel()}>📞 {SITE.phoneDisplay}</a>
  </div>
</header>

<style>
  .site-header {
    background: var(--paper);
    border-bottom: 3px solid var(--green);
  }
  .bar {
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 26px;
    padding: 14px clamp(20px, 4vw, 52px);
  }

  /* brand */
  .brand {
    text-decoration: none;
    color: var(--navy);
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.01em;
    white-space: nowrap;
    line-height: 1.1;
  }
  .brand span {
    color: var(--green-dark);
  }

  /* flat inline nav */
  .nav {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 22px;
    flex: 1 1 auto;
    min-width: 0;
  }
  .nav a {
    color: var(--navy);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 6px 2px;
    min-height: 44px;
    display: flex;
    align-items: center;
    white-space: nowrap;
  }
  .nav a:hover {
    color: var(--green-dark);
  }

  /* prominent phone */
  .header-phone {
    margin-left: auto;
    background: var(--green);
    color: var(--amber-ink);
    text-decoration: none;
    font-weight: 800;
    font-size: 1rem;
    padding: 10px 18px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .header-phone:hover {
    background: var(--green-dark);
    color: var(--amber-ink);
  }

  /* On smaller screens: brand + phone on the top row, nav wraps to its own row. */
  @media (max-width: 860px) {
    .bar {
      flex-wrap: wrap;
      gap: 12px 18px;
    }
    .brand {
      flex: 1;
    }
    .header-phone {
      margin-left: 0;
      order: 2;
    }
    .nav {
      order: 3;
      flex-basis: 100%;
      flex-wrap: wrap;
      gap: 4px 18px;
    }
  }
  @media (max-width: 480px) {
    .brand {
      font-size: 1.2rem;
      white-space: normal;
    }
    .nav {
      gap: 6px 14px;
    }
    .nav a {
      font-size: 0.9rem;
    }
  }
</style>
